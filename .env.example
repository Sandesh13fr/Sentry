# Copy to .env. Every value is optional: with no .env the app runs on the local parser and anchoring shows "unavailable".
PORT=3000

# AI parser via OpenRouter (https://openrouter.ai/keys). Leave blank to use the local rules-based parser.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Monad testnet anchoring. Testnet only. Use a throwaway wallet funded from the faucet.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
ANCHOR_PRIVATE_KEY=
ANCHOR_CONTRACT_ADDRESS=
EXPLORER_TX_URL=https://testnet.monadexplorer.com/tx/

# Match store. JSON file by default; set STORE=sqlite to use node:sqlite (Node 22.13+).
DATA_FILE=data/matches.json
STORE=json
